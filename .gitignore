# Secrets and per-user credentials
.env
.env.*
!.env.example
/config/.env
/config/ai-credentials.bin
/config/ai-credentials.bin.tmp

# Python environments, caches, coverage, and generated packaging state
/venv/
/env/
/.venv/
__pycache__/
*.py[cod]
/.cache/
/.pytest_cache/
/.mypy_cache/
/.ruff_cache/
/.coverage
/htmlcov/

# Frontend dependencies and generated output
/frontend/node_modules/
/frontend/dist/
/frontend/coverage/
/frontend/src-tauri/target/
/frontend/src-tauri/gen/
/frontend/src-tauri/binaries/*.exe

# Local application data and logs
/library/
/logs/
/BookBuddy/
/.codex-ui-logs/

# Generated audits, build outputs, and archived releases
/artifacts/
/audit-results*/
/build/
/dist/

# Local assistant and editor state
/.agents/
/.claude/
/.idea/
/.vscode/
*.swp
*.swo

# Operating-system and temporary files
.DS_Store
Thumbs.db
Desktop.ini
*.log
*.tmp
*.bak
*.orig
*.zip

# Executables are release artifacts. Publish installers and portable builds
# through GitHub Releases instead of committing binaries over GitHub's limit.
*.exe

# Test and TypeScript build caches
/.tmp-tests/
*.tsbuildinfo
